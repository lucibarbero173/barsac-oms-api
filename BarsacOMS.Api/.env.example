# Variables de entorno para producción en Railway

# Cadena de conexión a PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/base_datos
DATABASE_URL=postgresql://usuario:contraseña@host:puerto/barsac_oms

# Clave JWT (debe ser igual en todas las instancias)
Jwt__SecretKey=ClaveSecretaSuperSeguraParaBarsacOMS2026!

# Ambiente (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Production

# Puerto (Railway lo asigna automáticamente)
ASPNETCORE_URLS=http://0.0.0.0:5000
